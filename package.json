    "@types/react-dom": "^19.2.2",
    "agent-browser": "^0.32.1",
    "ai-cli": "^0.4.2",
    "drizzle-kit": "0.31.10",
    "emulate": "^0.9.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "portless": "^0.15.3",
    "react-doctor": "0.9.12",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
