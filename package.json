    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "2.50.0",
    "@tanstack/react-query": "^5.75.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "ahooks": "^3.9.5",
    "autoprefixer": "^10.4.21",
    "better-auth": "1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "fuse.js": "^7.1.0",
    "geist": "^1.4.1",
    "next": "16.3.2",
    "nodemailer": "9.0.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "stripe": "22.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@babel/runtime": "7.26.10",
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "defu": "6.1.5",
    "js-cookie": "3.0.8",
