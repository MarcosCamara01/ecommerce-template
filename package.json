{
  "name": "store-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run verify:release && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:push": "node scripts/database/forbid-db-push.mjs",
    "db:verify": "tsx scripts/database/verify.ts",
    "db:verify-concurrency": "node --conditions=react-server --import tsx scripts/database/verify-fulfillment-concurrency.ts",
    "db:apply-hosted": "node scripts/database/apply-hosted-exposure.mjs",
    "db:verify-hosted": "node scripts/database/verify-hosted-exposure.mjs",
    "db:mark-cutover": "tsx scripts/database/mark-migrations-applied.ts",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:release": "node scripts/release-readiness.mjs",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:studio": "tsx scripts/database/studio.ts",
    "db:pull": "tsx scripts/database/pull.ts",
    "doctor": "react-doctor --verbose --scope full --blocking warning",
    "doctor:staged": "react-doctor --staged --blocking warning --no-score",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.8",
