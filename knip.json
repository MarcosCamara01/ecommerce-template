{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "src/**/*.test.mjs",
    "src/**/*.test-d.ts",
    "*.test.mjs",
    "e2e.config.ts",
    "tests/**/*.e2e.ts"
